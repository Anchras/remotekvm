DATABASE_URL=postgres://postgres:postgres@localhost/remotekvm
REDIS_URL=redis://localhost:6379
PORT=8080
RUST_LOG=info,remotekvm_server=debug

# Public base URL of this server. Used to build the WorkOS redirect URI
# ({PUBLIC_BASE_URL}/auth/workos/callback). Defaults to http://localhost:{PORT}.
PUBLIC_BASE_URL=http://localhost:8080

# WorkOS (get from https://dashboard.workos.com)
WORKOS_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
WORKOS_CLIENT_ID=client_xxxxxxxxxxxxxxxxxxxx
# Override the WorkOS API base (used by integration tests to target a local mock).
# WORKOS_API_BASE=https://api.workos.com

# JWT Secret (generate a strong random string for production)
JWT_SECRET=change-me-in-production-generate-with-openssl-rand-base64-32
JWT_EXPIRY_HOURS=24
